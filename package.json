{
  "name": "@croct/plug",
  "version": "0.0.0-dev",
  "description": "A fully-featured devkit for building natively personalized applications.",
  "license": "MIT",
  "author": {
    "name": "Croct",
    "email": "lib+plug-js@croct.com",
    "url": "https://croct.com"
  },
  "keywords": [
    "croct",
    "personalization",
    "integration",
    "javascript",
    "typescript"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    "./*": {
      "import": "./*.js",
      "require": "./*.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croct-tech/plug-js.git"
  },
  "bugs": {
    "url": "https://github.com/croct-tech/plug-js/issues"
  },
  "homepage": "https://github.com/croct-tech/plug-js",
  "scripts": {
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "test": "jest -c jest.config.mjs --coverage",
    "validate": "tsc --noEmit",
    "build": "tsup",
    "postbuild": "./post-build.mjs",
    "bundle": "rollup -c"
  },
  "dependencies": {
    "@croct/content": "^1.1.0",
    "@croct/json": "^2.1.0",
    "@croct/sdk": "^0.22.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@croct/eslint-plugin": "^0.8.3",
    "@eslint/eslintrc": "^3.3.5",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "rollup": "^4.60.3",
    "schema-dts": "^2.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "browserslist": [
    "last 1 version"
  ],
  "files": [
    "**/*.js",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.ts",
    "**/*.mts",
    "**/*.cts",
    "**/*.map"
  ]
}
